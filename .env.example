# Copy these into Vercel -> Project -> Settings -> Environment Variables
# (never commit real values)

# Neon pooled connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Resend (https://resend.com) API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Where inquiry notifications are sent
ADMIN_NOTIFY_EMAIL=nexoratechnologies682@gmail.com

# "From" address. Use onboarding@resend.dev until you verify your own domain in Resend.
MAIL_FROM=NEXORA Website <onboarding@resend.dev>

# Must equal the owner password you type into the existing "Owner login" dialog.
# Lets the dashboard read inquiries from Neon.
ADMIN_PASSWORD=choose-a-long-password

# Optional: random string used to sign admin sessions (falls back to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=
